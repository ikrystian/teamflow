# ---------------------------------------------------------------------------
# Nexus — projekty i zadania (MongoDB) + klienci, sejf dostępów i konta (PostgreSQL)
# ---------------------------------------------------------------------------

# Publiczny adres aplikacji (logowanie, passkeys, linki w e-mailach i linki udostępniania).
# Musi się zgadzać z adresem w przeglądarce, łącznie z portem — inaczej logowanie
# kończy się błędem „Invalid origin” (np. gdy `next dev` wystartuje na innym porcie).
# Zastępuje NEXTAUTH_URL (stara nazwa jest nadal czytana jako wartość zapasowa).
APP_URL="http://localhost:3000"

# Sekret Better Auth, min. 32 znaki: openssl rand -base64 48
# Zastępuje NEXTAUTH_SECRET (stara nazwa jest nadal czytana, jeśli ma min. 32 znaki).
BETTER_AUTH_SECRET=""

# Sekret HMAC dla CAPTCHA proof-of-work przy logowaniu (opcjonalny — domyślnie
# wyprowadzany z BETTER_AUTH_SECRET).
CAPTCHA_SECRET=""

# Sekret zadań cyklicznych /api/cron/* (min. 16 znaków). Bez niego /api/cron/daily
# (przypomnienia o domenach, SSL, hasłach, retencja dziennika) jest wyłączony.
CRON_SECRET=""

# --- MongoDB: moduł projektów i zadań (Prisma) -----------------------------
# Lokalnie z docker-compose.yml (npm run db:up). Prisma wymaga replica setu;
# directConnection pomija wykrywanie replica setu.
DATABASE_URL="mongodb://localhost:27017/teamflow?replicaSet=rs0&directConnection=true"
# Atlas zamiast tego:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/teamflow?retryWrites=true&w=majority"

# --- PostgreSQL: konta (Better Auth), klienci (CRM), sejf E2E, dziennik ------
# Aplikacja łączy się rolą bez BYPASSRLS (Row Level Security), migracje uruchamia
# właściciel schematu: npm run db:pg:migrate
POSTGRES_URL="postgres://nexus_app:nexus_app@127.0.0.1:5434/nexus"
POSTGRES_MIGRATION_URL="postgres://nexus:nexus@127.0.0.1:5434/nexus"
# W produkcji wymuś TLS do bazy: POSTGRES_SSL=require
POSTGRES_SSL=disable

# --- Redis: wspólne limity prób logowania (puste = limity w pamięci procesu) --
REDIS_URL="redis://127.0.0.1:6381"

# --- E-mail (reset hasła, potwierdzenie adresu, zaproszenia, przypomnienia) --
# Gdy ustawiony RESEND_API_KEY — wysyłka przez Resend, w przeciwnym razie SMTP.
EMAIL_FROM="Nexus <no-reply@nexus.local>"
RESEND_API_KEY=
SMTP_HOST=127.0.0.1
SMTP_PORT=1027
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
# Dawne zmienne nexusa (używane, gdy brak EMAIL_FROM):
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=Nexus

# --- Tryb instalacji ----------------------------------------------------------
# single = jedna organizacja (domyślnie): wszyscy użytkownicy należą do jednej
# przestrzeni klientów, konta zakłada się z zaproszenia (poza pierwszym kontem
# nowej instalacji). saas = każdy może założyć konto i własną przestrzeń.
DEPLOYMENT_MODE=single
# Nazwa proponowana przy konfiguracji przestrzeni klientów organizacji.
ORG_NAME=
# Adres do zgłaszania podatności (security.txt); domyślnie security@<domena APP_URL>.
SECURITY_CONTACT_EMAIL=

# --- Logowanie Google / Microsoft (opcjonalne) --------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT_ID=common

# --- Monitoring (opcjonalny; dane z żądań sejfu są odfiltrowywane) -----------
SENTRY_DSN=

# --- Integracje modułu projektów ----------------------------------------------
# Pexels API (obrazy projektów)
PEXELS_API_KEY="your-pexels-api-key-here"

# Web push (przypomnienia o zadaniach). Parę kluczy wygeneruj raz:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Slack (zaplanowane notatki ze zmian); bot potrzebuje chat:write (+ files:write).
SLACK_BOT_TOKEN=

# OpenRouter (opisy zmian z commitów GitHub)
OPENROUTER_API_KEY=
