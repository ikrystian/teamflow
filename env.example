# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# MongoDB connection string (Prisma requires a database name in the path).
# See: https://pris.ly/d/connection-strings

# Local MongoDB from docker-compose.yml (start with: npm run db:up).
# Prisma needs a replica set; directConnection skips replica set discovery.
DATABASE_URL="mongodb://localhost:27017/teamflow?replicaSet=rs0&directConnection=true"

# Atlas instead:
# DATABASE_URL="mongodb+srv://USER:PASSWORD@HOST/teamflow?retryWrites=true&w=majority"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Pexels API
PEXELS_API_KEY="your-pexels-api-key-here"

# Web push (task reminders). Generate a key pair once with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# Slack integration (scheduled change-note messages); bot needs chat:write
# (+ files:write for image attachments).
SLACK_BOT_TOKEN=

# Shared secret protecting the /api/cron/* endpoints when called from system
# cron (see SLACK_SCHEDULER_SETUP.md). Optional — without it the endpoints
# also accept any logged-in session.
CRON_SECRET=
