# Environment variables declared in this file are automatically made available to Prisma.
# See the documentation for more detail: https://pris.ly/d/prisma-schema#accessing-environment-variables-from-the-schema

# MongoDB connection string (Prisma requires a database name in the path).
# See: https://pris.ly/d/connection-strings

DATABASE_URL="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/teamflow?retryWrites=true&w=majority"

# NextAuth.js
NEXTAUTH_SECRET="your-secret-key-here"
NEXTAUTH_URL="http://localhost:3000"

# Pexels API
PEXELS_API_KEY="your-pexels-api-key-here"

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=
