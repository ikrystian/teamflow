{
  "name": "Nexus",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "setup": "bash scripts/setup.sh",
    "db:up": "docker compose up -d --wait",
    "db:down": "docker compose down",
    "db:push": "prisma db push && node scripts/fix-mongo-indexes.js && node scripts/fix-mongo-nulls.js",
    "db:pg:migrate": "tsx scripts/migrate-pg.ts",
    "db:pg:generate": "drizzle-kit generate",
    "db:pg:studio": "drizzle-kit studio",
    "db:pg:seed": "tsx --conditions=react-server scripts/seed-crm.ts",
    "migrate:legacy": "tsx --conditions=react-server scripts/migrate-legacy.ts",
    "ci": "npm run lint && npm run typecheck && npm run test && npm run build"
  },
